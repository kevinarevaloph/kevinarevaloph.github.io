602 0 obj
  << /ActualText (Connect Beyond the Sessions\n\nThe bar crawl gives you dedicated time with fellow dealership leaders outside the conference walls\056 Share what\031s working\054 talk through what isn\031t\054 and build relationships that carry past the event\056\015\n\nMeet peers from dealerships across the country\nConnect with solution providers in a low\055pressure setting\nExperience Detroit\031s downtown bar scene with a built\055in crew\nKeep the momentum from the conference floor going into the evening)
     /K [ 5 ]
     /P 603 0 R
     /Pg 592 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

