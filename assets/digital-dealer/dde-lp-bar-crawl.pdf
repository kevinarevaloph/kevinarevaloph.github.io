  << /K [ 602 0 R ]
     /P 608 0 R
     /S /P
     /Pg 592 0 R
     /Type /StructElem
  >>
endobj

604 0 obj
  << /ActualText (Four Stops\056 \nOne Night\056\015\n\nThe crawl runs through four of Detroit\031s standout spots\056 Each venue offers a distinct atmosphere\054 keeping the energy moving from start to finish\056)
     /K [ 6 ]
     /P 605 0 R
     /Pg 592 0 R
     /S /Span
     /Type /StructElem
  >>
